{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1/es/index.html",
        "http://127.0.0.1/en/index.html",
        "http://127.0.0.1/es/experiencia/seek/index.html",
        "http://127.0.0.1/en/experience/seek/index.html",
        "http://127.0.0.1/es/perfiles/mobile-flutter/index.html"
      ],
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    }
  }
}
