---
import type { Lang } from '../i18n/ui';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../data/copy';
import { pageSeo } from '../data/seo';
import { site } from '../data/site';
import { localePath } from '../i18n/paths';
import { tx, ui } from '../i18n/ui';
import { breadcrumbGraph } from '../lib/structured-data';

interface Props {
  lang: Lang;

}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = localePath(lang, '/contacto/');
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.contact, href: pathname },
];
---
<BaseLayout
  lang={lang}
  title={pageSeo.contact[lang].title}
  description={pageSeo.contact[lang].description}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="h-wrap page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <header>
      <h1 id="titulo">{t.contact}</h1>
      <p class="lead">{tx(lang, copy.contactPrompt)}</p>
      <div class="cluster">
        <a class="button" href={`mailto:${site.email}`}>{t.contactCta}</a>
        <a class="button button--ghost" href={site.links.linkedin} rel="me noopener noreferrer" target="_blank">
          LinkedIn
          <span class="sr-only"> ({t.newTab})</span>
        </a>
      </div>
    </header>
    <form
      class="form"
      name="contact"
      method="POST"
      action={localePath(lang, '/contacto/enviado/')}
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" value={`Contacto — ${site.name}`} />
      <input type="hidden" name="locale" value={lang} />
      <p class="honeypot">
        <label>
          {t.honeypot}
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>
      <label class="field">
        {t.formName}
        <input id={`nombre-${lang}`} name="name" type="text" required autocomplete="name" />
      </label>
      <label class="field">
        {t.formEmail}
        <input id={`correo-${lang}`} name="email" type="email" required autocomplete="email" />
      </label>
      <label class="field">
        {t.formMessage}
        <textarea id={`mensaje-${lang}`} name="message" required></textarea>
      </label>
      <p class="kicker">{t.formHint}</p>
      <button class="button" type="submit">{t.formSend}</button>
    </form>
  </div>
</BaseLayout>
