---
import type { Lang } from '../i18n/ui';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBand from '../components/ContactBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profiles } from '../data/profiles';
import { pageSeo } from '../data/seo';
import { site } from '../data/site';
import { localePath } from '../i18n/paths';
import { tx, ui } from '../i18n/ui';
import { breadcrumbGraph } from '../lib/structured-data';

interface Props {
  lang: Lang;

}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = localePath(lang, '/perfiles/');
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.profiles, href: pathname },
];
---
<BaseLayout
  lang={lang}
  title={pageSeo.profilesIndex[lang].title}
  description={pageSeo.profilesIndex[lang].description}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="h-wrap page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <div class="h-section__head">
      <p class="h-eyebrow">{t.profiles}</p>
      <h1 id="titulo">{t.profilesTitle}</h1>
    </div>
    <ul class="h-profiles">
      {
        profiles.map((profile, index) => {
          const name = tx(lang, profile.name);
          return (
            <li class="h-profile">
              <span class="h-profile__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{name}</h3>
              <p>{tx(lang, profile.summary)}</p>
              <ul class="h-chips" aria-label={t.techLabel}>
                {profile.stack[lang].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="h-profile__link" href={localePath(lang, `/perfiles/${profile.slug}/`)}>
                {t.viewProfile}<span class="sr-only"> {name}</span> →
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
