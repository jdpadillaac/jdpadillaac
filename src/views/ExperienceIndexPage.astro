---
import type { Lang } from '../i18n/ui';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBand from '../components/ContactBand.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../data/seo';
import { localePath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import { publishedExperiences } from '../lib/content';
import { breadcrumbGraph } from '../lib/structured-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = localePath(lang, '/experiencia/');
const experiences = await publishedExperiences();
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.experience, href: pathname },
];
---
<BaseLayout
  lang={lang}
  title={pageSeo.experienceIndex[lang].title}
  description={pageSeo.experienceIndex[lang].description}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="h-wrap page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <div class="h-section__head">
      <p class="h-eyebrow">{t.experience}</p>
      <h1 id="titulo">{t.builtTitle}</h1>
      <p>{t.builtSub}</p>
    </div>
    {
      experiences.length > 0 && <ExperienceTimeline lang={lang} entries={experiences} />
    }
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
