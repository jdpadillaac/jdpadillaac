---
import type { Lang } from '../i18n/ui';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBand from '../components/ContactBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../data/seo';
import { site } from '../data/site';
import { localePath } from '../i18n/paths';
import { tx, ui } from '../i18n/ui';
import { publishedCases, publishedExperiences } from '../lib/content';
import { breadcrumbGraph } from '../lib/structured-data';

interface Props {
  lang: Lang;

}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = localePath(lang, '/experiencia/');
const experiences = await publishedExperiences();
const cases = await publishedCases();
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.experience, href: pathname },
];
---
<BaseLayout
  lang={lang}
  title={pageSeo.experienceIndex[lang].title}
  description={pageSeo.experienceIndex[lang].description}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="h-wrap page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <div class="h-section__head">
      <p class="h-eyebrow">{t.experience}</p>
      <h1 id="titulo">{t.builtTitle}</h1>
      <p>{t.builtSub}</p>
    </div>
    {
      experiences.length > 0 && (
        <ul class="h-list">
          {experiences.map((entry) => {
            const childCases = cases.filter((item) => item.data.experienceSlug === entry.data.slug);
            return (
              <li>
                <a href={localePath(lang, `/experiencia/${entry.data.slug}/`)}>
                  <span>
                    <span class="h-list__company">{tx(lang, entry.data.company)}</span>
                    <span class="h-list__meta">
                      {tx(lang, entry.data.title)} · {tx(lang, entry.data.start)} — {tx(lang, entry.data.end)}
                    </span>
                  </span>
                  <span class="h-list__go">{t.viewPage} →</span>
                </a>
                {childCases.length > 0 && (
                  <ul class="link-list">
                    {childCases.map((item) => (
                      <li>
                        <a
                          class="row-link"
                          href={localePath(lang, `/experiencia/${entry.data.slug}/casos/${item.data.slug}/`)}
                        >
                          <span class="row-link__title">{tx(lang, item.data.title)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
