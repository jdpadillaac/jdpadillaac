---
import type { Lang } from '../i18n/ui';
import HomeLayout from '../layouts/HomeLayout.astro';
import { cvAvailable, cvFile, cvHref } from '../data/cv';
import { copy } from '../data/copy';
import { homeFeature, homeH1, homeLead } from '../data/home';
import { profiles } from '../data/profiles';
import { site } from '../data/site';
import { localePath } from '../i18n/paths';
import { tx, ui } from '../i18n/ui';
import { publishedExperiences } from '../lib/content';
import { pageGraph } from '../lib/structured-data';
import { siteLastModified } from '../lib/seo-dates';

interface Props {
  lang: Lang;

}

const { lang } = Astro.props;
const t = ui[lang];
const pathname = localePath(lang, '/');
const experiences = await publishedExperiences();
const featured = experiences.find((entry) => entry.data.featured) ?? experiences[0];
const rest = featured
  ? experiences.filter((entry) => entry.data.slug !== featured.data.slug)
  : [];
const cvEs = cvAvailable('es');
const cvEn = cvAvailable('en');
const cvEsHref = cvEs ? cvHref('es') : localePath(lang, '/cv/#cv-es');
const cvEnHref = cvEn ? cvHref('en') : localePath(lang, '/cv/#cv-en');
function dates(entry: (typeof experiences)[number]) {
  return `${tx(lang, entry.data.start)} — ${tx(lang, entry.data.end)}`;
}
const featuredKicker = featured
  ? `${tx(lang, featured.data.company)} · ${dates(featured)}`
  : '';
---
<HomeLayout
  lang={lang}
  title={t.seoHomeTitle}
  description={t.seoHome}
  pathname={pathname}
  jsonLd={await pageGraph({
    lang,
    pathname,
    pageType: 'ProfilePage',
    title: t.seoHomeTitle,
    description: t.seoHome,
    dateModified: siteLastModified,
  })}
>
  <section class="h-hero" aria-labelledby="h-title">
    <div class="h-wrap h-hero__grid">
      <div>
        <p class="h-pill">{tx(lang, copy.availability)}</p>
        <p class="h-eyebrow">{tx(lang, copy.label)}</p>
        <h1 id="h-title">{tx(lang, homeH1)}</h1>
        <p class="h-lead">{tx(lang, homeLead)}</p>
        <p class="h-lead">{tx(lang, copy.lede)}</p>
        <div class="h-actions">
          <div class="h-btn-group">
            <a class="h-btn h-btn--primary" href={cvEsHref} download={cvEs ? cvFile('es') : undefined}>
              {t.downloadCvEs}
            </a>
            <a class="h-btn h-btn--outline" href={cvEnHref} download={cvEn ? cvFile('en') : undefined}>
              {t.downloadCvEn}
            </a>
          </div>
          <div class="h-textlinks">
            <a class="h-textlink" href="#experiencia">{t.viewExperience} →</a>
            <a
              class="h-textlink"
              href={site.links.linkedin}
              target="_blank"
              rel="noopener"
            >
              LinkedIn<span class="sr-only"> ({t.newTab})</span>
            </a>
          </div>
        </div>
      </div>

      <aside class="h-summary" aria-label={t.summaryLabel}>
        <p class="h-summary__title">{t.atAGlance}</p>
        <dl>
          <div class="h-summary__row">
            <dt>{t.sumNow}</dt>
            <dd>{t.sumNowValue}</dd>
          </div>
          <div class="h-summary__row">
            <dt>{t.sumBefore}</dt>
            <dd>{t.sumBeforeValue}</dd>
          </div>
          <div class="h-summary__row">
            <dt>{t.sumStack}</dt>
            <dd>{t.sumStackValue}</dd>
          </div>
          <div class="h-summary__row">
            <dt>{t.sumBase}</dt>
            <dd>{t.sumBaseValue}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="h-section" id="perfiles" aria-labelledby="perfiles-title">
    <div class="h-wrap">
      <div class="h-section__head">
        <p class="h-eyebrow">{t.profiles}</p>
        <h2 id="perfiles-title">{t.profilesTitle}</h2>
      </div>
      <ul class="h-profiles">
        {
          profiles.map((profile, index) => {
            const name = tx(lang, profile.name);
            return (
              <li class="h-profile">
                <span class="h-profile__num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{name}</h3>
                <p>{tx(lang, profile.summary)}</p>
                <ul class="h-chips" aria-label={t.techLabel}>
                  {profile.stack[lang].map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <a class="h-profile__link" href={localePath(lang, `/perfiles/${profile.slug}/`)}>
                  {t.viewProfile}<span class="sr-only"> {name}</span> →
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {
    featured && (
      <section class="h-section" id="experiencia" aria-labelledby="experiencia-title">
        <div class="h-wrap">
          <div class="h-section__head">
            <p class="h-eyebrow">{t.experience}</p>
            <h2 id="experiencia-title">{t.builtTitle}</h2>
            <p>{t.builtSub}</p>
          </div>

          <article class="h-feature" aria-labelledby="seek-title">
            <div class="h-feature__media">
              <div>
                <p class="h-eyebrow">{t.client}</p>
                <p class="h-feature__client">{tx(lang, homeFeature.client)}</p>
                <p class="h-feature__products">{tx(lang, homeFeature.products)}</p>
              </div>
              <ul class="h-chips" aria-label={t.techLabel}>
                {homeFeature.chips.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="h-feature__body">
              <p class="h-eyebrow">{featuredKicker}</p>
              <h3 id="seek-title">{tx(lang, featured.data.title)}</h3>
              <p class="h-feature__summary">{tx(lang, featured.data.summary)}</p>
              <ul class="h-checks">
                {homeFeature.highlights[lang].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="h-textlink" href={localePath(lang, `/experiencia/${featured.data.slug}/`)}>
                {t.readCase} →
              </a>
            </div>
          </article>

          {rest.length > 0 && (
            <div class="h-others">
              <h3>{t.otherExperiences}</h3>
              <ul class="h-list">
                {rest.map((entry) => (
                  <li>
                    <a href={localePath(lang, `/experiencia/${entry.data.slug}/`)}>
                      <span>
                        <span class="h-list__company">{tx(lang, entry.data.company)}</span>
                        <span class="h-list__meta">
                          {tx(lang, entry.data.title)} · {dates(entry)}
                        </span>
                      </span>
                      <span class="h-list__go" aria-hidden="true">
                        {t.viewPage} →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="h-band" id="contacto" aria-labelledby="contacto-title">
    <div class="h-wrap h-band__grid">
      <div>
        <p class="h-eyebrow">{t.contact}</p>
        <h2 id="contacto-title">{t.bandTitle}</h2>
        <p class="h-band__text">{t.bandText}</p>
        <div class="h-btn-group">
          <a class="h-btn h-btn--light" href={cvEsHref} download={cvEs ? cvFile('es') : undefined}>
            {t.downloadCvEs}
          </a>
          <a class="h-btn h-btn--ghost" href={cvEnHref} download={cvEn ? cvFile('en') : undefined}>
            {t.downloadCvEn}
          </a>
        </div>
      </div>
      <ul class="h-channels">
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="h-channels__label">{t.email}</span>
            <span class="h-channels__value">{site.email}</span>
          </a>
        </li>
        <li>
          <a href={site.links.linkedin} target="_blank" rel="noopener">
            <span class="h-channels__label">LinkedIn</span>
            <span class="h-channels__value">
              {t.linkedinShort}<span class="sr-only"> ({t.newTab})</span>
            </span>
          </a>
        </li>
        <li>
          <a href={localePath(lang, '/contacto/')}>
            <span class="h-channels__label">{t.formLabel}</span>
            <span class="h-channels__value">{t.formValue}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</HomeLayout>
