---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Proyectos — Jonatan Padilla"
  description="Selección de proyectos en Flutter, iOS, Go, Java y TypeScript con arquitectura limpia y productos en producción."
  ogImage="/og/default.svg"
  currentPath="/proyectos"
>
  <div class="shell">
    <header class="prose">
      <h1>Proyectos</h1>
      <p>
        Trabajo reciente y referencias técnicas: apps mobile, APIs, integraciones con SDKs y
        experimentos con arquitectura hexagonal.
      </p>
    </header>
    <div class="card-grid section">
      {
        projects.map((project) => (
          <ProjectCard
            href={`/proyectos/${project.id}`}
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
