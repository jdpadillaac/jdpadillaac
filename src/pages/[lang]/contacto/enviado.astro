---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';
import { isLang, localePath, staticLangs } from '../../../i18n/paths';
import { ui } from '../../../i18n/ui';

export function getStaticPaths() {
  return staticLangs();
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang = langParam;
const t = ui[lang];
const pathname = localePath(lang, '/contacto/enviado/');
---

<BaseLayout lang={lang} title={`${t.sentTitle} — ${site.name}`} description={t.seoSent} pathname={pathname} noindex={true}>
  <div class="h-wrap page">
    <header>
      <h1 id="titulo">{t.sentTitle}</h1>
      <p class="lead">{t.sentBody}</p>
    </header>
    <div class="cluster">
      <a class="button" href={localePath(lang, '/contacto/')}>{t.sentBack}</a>
      <a class="button button--ghost" href={localePath(lang, '/')}>{t.home}</a>
    </div>
  </div>
</BaseLayout>
