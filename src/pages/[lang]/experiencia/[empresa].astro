---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ContactBand from '../../../components/ContactBand.astro';
import Study from '../../../components/Study.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';
import { isLang, langs, localePath } from '../../../i18n/paths';
import { tx, ui } from '../../../i18n/ui';
import { publishedCases, publishedExperiences } from '../../../lib/content';
import { breadcrumbGraph } from '../../../lib/structured-data';

export async function getStaticPaths() {
  const experiences = await publishedExperiences();
  return langs.flatMap((lang) => experiences.map((entry) => ({ params: { lang, empresa: entry.data.slug } })));
}

const langParam = Astro.params.lang;
const empresa = Astro.params.empresa;
if (!isLang(langParam) || !empresa) throw new Error('Unsupported experience');
const lang = langParam;
const t = ui[lang];
const experiences = await publishedExperiences();
const entry = experiences.find((item) => item.data.slug === empresa);
if (!entry) throw new Error(`Missing experience: ${empresa}`);

const cases = (await publishedCases()).filter((item) => item.data.experienceSlug === entry.data.slug);
const pathname = localePath(lang, `/experiencia/${entry.data.slug}/`);
const company = tx(lang, entry.data.company);
const title = tx(lang, entry.data.title);
const dates = `${tx(lang, entry.data.start)} — ${tx(lang, entry.data.end)}`;
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.experience, href: localePath(lang, '/experiencia/') },
  { label: company, href: pathname },
];
const sections = [
  { id: 'contexto', title: t.context, body: tx(lang, entry.data.context) },
  { id: 'rol', title: t.roleSection, body: tx(lang, entry.data.roleNarrative) },
  { id: 'reto', title: t.challenge, body: tx(lang, entry.data.challenge) },
  { id: 'solucion', title: t.solution, body: tx(lang, entry.data.solution) },
];
---

<BaseLayout
  lang={lang}
  title={`${title} — ${company} — ${site.name}`}
  description={tx(lang, entry.data.description)}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="container page">
    <Study
      lang={lang}
      kicker={`${company} · ${dates}`}
      title={title}
      summary={tx(lang, entry.data.summary)}
      facts={{
        role: tx(lang, entry.data.role),
        dates,
        team: tx(lang, entry.data.team),
        stack: entry.data.stack[lang],
      }}
      heroAlt={tx(lang, entry.data.heroAlt)}
      results={entry.data.results.map((item) => ({ value: tx(lang, item.value), label: tx(lang, item.label) }))}
      sections={sections}
      shots={entry.data.gallery.map((shot) => tx(lang, shot.alt))}
      learnings={tx(lang, entry.data.learnings)}
      cases={cases.map((item) => ({
        href: localePath(lang, `/experiencia/${entry.data.slug}/casos/${item.data.slug}/`),
        title: tx(lang, item.data.title),
        meta: tx(lang, item.data.summary),
      }))}
      others={experiences
        .filter((item) => item.data.slug !== entry.data.slug)
        .map((item) => ({
          href: localePath(lang, `/experiencia/${item.data.slug}/`),
          title: tx(lang, item.data.company),
          meta: `${tx(lang, item.data.title)} · ${tx(lang, item.data.start)} — ${tx(lang, item.data.end)}`,
        }))}
    >
      <Breadcrumbs slot="crumbs" items={crumbs} label={t.breadcrumbs} />
    </Study>
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
