---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBand from '../../components/ContactBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cvAvailable, cvHref } from '../../data/cv';
import { site } from '../../data/site';
import { isLang, localePath, staticLangs } from '../../i18n/paths';
import { ui } from '../../i18n/ui';
import { breadcrumbGraph } from '../../lib/structured-data';

export function getStaticPaths() {
  return staticLangs();
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang = langParam;
const t = ui[lang];
const pathname = localePath(lang, '/cv/');
const files = [
  { id: 'cv-es', title: t.cvEsTitle, lang: 'es' as const },
  { id: 'cv-en', title: t.cvEnTitle, lang: 'en' as const },
];
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.cv, href: pathname },
];
---

<BaseLayout lang={lang} title={`${t.cv} — ${site.name}`} description={t.seoCv} pathname={pathname} jsonLd={breadcrumbGraph(crumbs)}>
  <div class="container page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <header>
      <h1 id="titulo">{t.cv}</h1>
    </header>
    {
      files.map((file) => {
        const available = cvAvailable(file.lang);
        return (
          available && (
            <section id={file.id} aria-labelledby={`${file.id}-titulo`}>
              <h2 id={`${file.id}-titulo`}>{file.title}</h2>
              <a class="button" href={cvHref(file.lang)} download>
                {t.cvDownload}
              </a>
            </section>
          )
        );
      })
    }
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
