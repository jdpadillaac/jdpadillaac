---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ContactBand from '../../../components/ContactBand.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';
import { isLang, localePath, staticLangs } from '../../../i18n/paths';
import { ui } from '../../../i18n/ui';
import { publishedProjects } from '../../../lib/content';
import { breadcrumbGraph } from '../../../lib/structured-data';

export function getStaticPaths() {
  return staticLangs();
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang = langParam;
const t = ui[lang];
const pathname = localePath(lang, '/proyectos/');
const projects = await publishedProjects();
const crumbs = [
  { label: t.home, href: localePath(lang, '/') },
  { label: t.projects, href: pathname },
];
---

<BaseLayout
  lang={lang}
  title={`${t.projects} — ${site.name}`}
  description={t.seoProjects}
  pathname={pathname}
  jsonLd={breadcrumbGraph(crumbs)}
>
  <div class="h-wrap page">
    <Breadcrumbs items={crumbs} label={t.breadcrumbs} />
    <header>
      <h1 id="titulo">{t.projects}</h1>
    </header>
    <ul class="link-list">
      {
        projects.map((project) => (
          <li>
            <a class="row-link" href={localePath(lang, `/proyectos/${project.id}/`)}>
              <span class="row-link__title">{project.data.title}</span>
              {
                (lang === 'es' ? project.data.summary : project.data.summaryEn) !== '[Pendiente: traducción]' && (
                  <span class="kicker">{lang === 'es' ? project.data.summary : project.data.summaryEn}</span>
                )
              }
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <ContactBand lang={lang} />
</BaseLayout>
