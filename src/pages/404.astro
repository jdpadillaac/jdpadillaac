---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { ui } from '../i18n/ui';
---

<BaseLayout
  lang="es"
  title={`${ui.es.notFound} — ${site.name}`}
  description={ui.es.notFoundLead}
  pathname="/404/"
  localized={false}
  noindex={true}
  alternates={{ es: '/es/', en: '/en/' }}
>
  <div class="container page">
    <header>
      <h1 id="titulo">{ui.es.notFound}</h1>
      <p class="lead">{ui.es.notFoundLead}</p>
      <p class="lead" lang="en">{ui.en.notFoundLead}</p>
    </header>
    <div class="cluster">
      <a class="button" href="/es/">Español</a>
      <a class="button button--ghost" href="/en/" lang="en">English</a>
    </div>
  </div>
</BaseLayout>
