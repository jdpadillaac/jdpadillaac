---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Sobre mí — Jonatan Padilla"
  description="Trayectoria de Jonatan Padilla como ingeniero de software y arquitecto mobile en Colombia."
  ogImage="/og/default.svg"
  currentPath="/sobre-mi"
>
  <div class="shell prose">
    <h1>Sobre mí</h1>
    {profile.bio.map((paragraph) => <p>{paragraph}</p>)}

    <h2>En qué trabajo</h2>
    <p>
      Productos mobile con Flutter e iOS, servicios backend con Java/Spring Boot y Go, y frontends
      con TypeScript cuando el producto lo requiere. Priorizo contratos claros entre capas, pruebas
      en dominio y despliegues repetibles.
    </p>

    <h2>Stack frecuente</h2>
    <ul class="chip-list">
      {profile.skills.map((skill) => (
        <li><span class="chip">{skill}</span></li>
      ))}
    </ul>

    <h2>Enlaces</h2>
    <ul>
      <li><a href={profile.links.github}>GitHub</a></li>
      <li><a href={profile.links.linkedin}>LinkedIn</a></li>
      <li><a href={profile.links.x}>X (@jdpadillac_)</a></li>
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
</BaseLayout>
