---
const title = 'Jonatan Padilla';
const description = 'Portafolio de Jonatan Padilla.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#F6F3EC" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f6f3ec;
        color: #1b1a17;
        font-family: Georgia, serif;
      }
      main { padding: 24px; }
      h1 { font-weight: 500; font-size: clamp(2.5rem, 6vw, 4rem); margin: 0 0 12px; }
      p { margin: 0 0 16px; color: #3f3b33; }
      a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin: 8px 8px 0 0;
        padding: 0 18px;
        border-radius: 999px;
        background: #0f5c4d;
        color: #fff;
        text-decoration: none;
      }
    </style>
    <script is:inline>
      const list = navigator.languages?.length ? navigator.languages : [navigator.language || 'en'];
      let target = 'en';
      for (const item of list) {
        const tag = String(item).toLowerCase().split('-')[0];
        if (tag === 'es' || tag === 'en') {
          target = tag;
          break;
        }
      }
      location.replace('/' + target + '/' + location.search + location.hash);
    </script>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Español / English</p>
      <a href="/es/">Español</a>
      <a href="/en/" lang="en">English</a>
    </main>
  </body>
</html>
