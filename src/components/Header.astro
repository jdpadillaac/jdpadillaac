---
import { site } from '../data/site';
import { localePath, swapLang } from '../i18n/paths';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  pathname: string;
  alternates?: { es: string; en: string };
}

const { lang, pathname, alternates } = Astro.props;
const t = ui[lang];
const hrefs = {
  es: alternates?.es ?? swapLang(pathname, 'es'),
  en: alternates?.en ?? swapLang(pathname, 'en'),
};

const items = [
  { href: localePath(lang, '/'), label: t.home, exact: true },
  { href: localePath(lang, '/perfiles/'), label: t.profiles },
  { href: localePath(lang, '/experiencia/'), label: t.experience },
  { href: localePath(lang, '/sobre-mi/'), label: t.about },
  { href: localePath(lang, '/contacto/'), label: t.contact },
  { href: localePath(lang, '/cv/'), label: t.cv },
];

function current(href: string, exact = false) {
  if (exact || href === localePath(lang, '/')) return pathname === href;
  return pathname === href || pathname.startsWith(href);
}
---

<header class="header">
  <div class="container header__bar" data-open="false">
    <a class="brand" href={localePath(lang, '/')}>{site.name}</a>
    <nav id="navegacion" aria-label={t.navLabel}>
      <ul class="nav">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href, item.exact) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={t.languageLabel}>
      <ul class="lang-switch">
        <li>
          <a href={hrefs.es} hreflang="es" lang="es" aria-current={hrefs.es === pathname ? 'page' : undefined}>ES</a>
        </li>
        <li>
          <a href={hrefs.en} hreflang="en" lang="en" aria-current={hrefs.en === pathname ? 'page' : undefined}>EN</a>
        </li>
      </ul>
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="navegacion">
      {t.menu}
    </button>
  </div>
</header>

<script>
  const bar = document.querySelector('.header__bar');
  const button = document.querySelector('.menu-button');
  if (bar instanceof HTMLElement && button instanceof HTMLButtonElement) {
    button.addEventListener('click', () => {
      const open = bar.dataset.open === 'true';
      bar.dataset.open = open ? 'false' : 'true';
      button.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
    bar.querySelectorAll('#navegacion a').forEach((link) => {
      link.addEventListener('click', () => {
        bar.dataset.open = 'false';
        button.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
