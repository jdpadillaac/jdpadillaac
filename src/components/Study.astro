---
import { ui, type Lang } from '../i18n/ui';
import Frame from './Frame.astro';

interface LinkItem {
  href: string;
  title: string;
  meta?: string;
}

interface Stage {
  role: string;
  period: string;
  summary: string;
}

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  summary: string;
  facts?: { role: string; dates: string; team?: string; stack?: string[] };
  heroAlt?: string;
  results?: { value: string; label: string }[];
  sections?: { id: string; title: string; body: string }[];
  shots?: string[];
  learnings?: string;
  highlights?: string[];
  stages?: Stage[];
  cases?: LinkItem[];
  others?: LinkItem[];
}

const {
  lang,
  kicker,
  title,
  summary,
  facts,
  heroAlt,
  results = [],
  sections = [],
  shots = [],
  learnings,
  highlights = [],
  stages = [],
  cases = [],
  others = [],
} = Astro.props;
const narrative = sections.filter((section) => section.body.trim());
const pair = (a?: { id: string; title: string; body: string }, b?: { id: string; title: string; body: string }) =>
  [a, b].filter((section) => section !== undefined && section.body.trim());
const byId = (id: string) => narrative.find((section) => section.id === id);
const firstPair = pair(byId('contexto'), byId('rol'));
const secondPair = pair(byId('reto'), byId('solucion'));
const pairedIds = new Set([...firstPair, ...secondPair].map((section) => section.id));
const remaining = narrative.filter((section) => !pairedIds.has(section.id));
const trimmedLearnings = learnings?.trim();
const t = ui[lang];
---

<div class="study">
  <slot name="crumbs" />
  <header>
    <p class="study__kicker kicker">{kicker}</p>
    <h1 id="titulo">{title}</h1>
    <p class="study__summary">{summary}</p>
  </header>
  {
    facts && (
      <section class="facts facts--bar" aria-label={t.facts}>
        <dl>
          <div>
            <dt>{t.role}</dt>
            <dd>{facts.role}</dd>
          </div>
          <div>
            <dt>{t.dates}</dt>
            <dd>{facts.dates}</dd>
          </div>
          {facts.stack && facts.stack.length > 0 && (
          <div>
            <dt>{t.stack}</dt>
            <dd>
                <ul class="pills">
                  {facts.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
            </dd>
          </div>
          )}
          {facts.team && facts.team.trim() && (
            <div>
              <dt>{t.team}</dt>
              <dd>{facts.team}</dd>
            </div>
          )}
        </dl>
      </section>
    )
  }
  {heroAlt && (
    <div class="frame--hero">
      <Frame alt={heroAlt} />
    </div>
  )}
  {
    highlights.length > 0 && (
      <section aria-labelledby="que-hice">
        <h2 id="que-hice">{t.whatIDid}</h2>
        <ul class="h-checks">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )
  }
  {
    firstPair.length > 0 && (
      <div class="pair-grid">
        {firstPair.map((section) => (
          <article aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </div>
    )
  }
  {
    secondPair.length > 0 && (
      <div class="pair-grid">
        {secondPair.map((section) => (
          <article aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </div>
    )
  }
  {
    stages.length > 0 && (
      <section aria-labelledby="etapas">
        <h2 id="etapas">{t.stages}</h2>
        <ol class="stages">
          {stages.map((stage) => (
            <li>
              <h3>{stage.role}</h3>
              <p class="kicker">{stage.period}</p>
              <p>{stage.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }
  {
    results.length > 0 && (
      <section aria-labelledby="resultados">
        <h2 id="resultados">{t.results}</h2>
        <ul class="results">
          {results.map((item) => (
            <li>
              <p class="result__value">{item.value}</p>
              <p class="result__label">{item.label}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    remaining.map((section) => (
      <section class="narrative" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        <p>{section.body}</p>
      </section>
    ))
  }
  {
    shots.length > 0 && (
      <section aria-labelledby="capturas">
        <h2 id="capturas">{t.shots}</h2>
        <div class="shot-grid">
          {shots.map((alt) => (
            <Frame alt={alt} />
          ))}
        </div>
      </section>
    )
  }
  {
    trimmedLearnings && (
      <section class="narrative" aria-labelledby="aprendizajes">
        <h2 id="aprendizajes">{t.learnings}</h2>
        <p>{trimmedLearnings}</p>
      </section>
    )
  }
  {
    cases.length > 0 && (
      <section aria-labelledby="casos">
        <h2 id="casos">{t.cases}</h2>
        <ul class="link-list">
          {cases.map((item) => (
            <li>
              <a class="row-link" href={item.href}>
                <span class="row-link__title">{item.title}</span>
                {item.meta && <span class="kicker">{item.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    others.length > 0 && (
      <section class="other-experiences" aria-labelledby="otras-experiencias">
        <h2 id="otras-experiencias">{t.otherExperiences}</h2>
        <ul class="h-list">
          {others.map((item) => (
            <li>
              <a href={item.href}>
                <span>
                  <span class="h-list__company">{item.title}</span>
                  {item.meta && <span class="h-list__meta">{item.meta}</span>}
                </span>
                <span class="h-list__go">{t.viewPage} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
