---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  variant: 'featured' | 'compact';
  initials: string;
  image?: { src: ImageMetadata; alt: string };
}

const { variant, initials, image } = Astro.props;
---

<div class:list={['exp-media', `exp-media--${variant}`]}>
  {
    image ? (
      <Image
        src={image.src}
        alt={image.alt}
        width={variant === 'featured' ? 960 : 240}
        height={variant === 'featured' ? 720 : 180}
        widths={variant === 'featured' ? [480, 768, 960] : [72, 120, 240]}
        sizes={variant === 'featured' ? '(max-width: 767px) 100vw, 480px' : '(max-width: 639px) 72px, 120px'}
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="exp-media__monogram" aria-hidden="true">
        <span>{initials}</span>
      </div>
    )
  }
</div>
